{
    "name": "simple-sqlite-wrapper",
    "version": "1.3.6",
    "description": "A lightweight wrapper around better-sqlite3 for simplified database operations.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "keywords": [
        "sqlite",
        "wrapper",
        "database"
    ],
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "build": "tsc",
        "clean": "rm -rf dist",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write .",
        "start": "node dist/index.js",
        "watch": "tsc --watch",
        "prepare": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bob16077/simple-sqlite-wrapper.git"
    },
    "author": "Bob16077777 Development",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Bob16077/simple-sqlite-wrapper/issues"
    },
    "homepage": "https://github.com/Bob16077/simple-sqlite-wrapper#readme",
    "dependencies": {
        "better-sqlite3": "^11.9.1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.2"
    }
}
