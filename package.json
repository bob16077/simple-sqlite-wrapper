{
    "name": "simple-sqlite-wrapper",
    "version": "1.4.0",
    "description": "A lightweight wrapper around better-sqlite3 for simplified database operations.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist/**",
        "README.md",
        "LICENSE",
        "docs/API_AND_ARCHITECTURE.md"
    ],
    "keywords": [
        "sqlite",
        "wrapper",
        "database"
    ],
    "scripts": {
        "rebuild:native": "npm rebuild better-sqlite3",
        "doctor": "npm run rebuild:native && npm run build && npm test -- --runInBand",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "build": "tsc",
        "clean": "rm -rf dist",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write .",
        "start": "node dist/index.js",
        "watch": "tsc --watch",
        "prepare": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bob16077/simple-sqlite-wrapper.git"
    },
    "author": "bob16077",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/bob16077/simple-sqlite-wrapper/issues"
    },
    "homepage": "https://github.com/bob16077/simple-sqlite-wrapper#readme",
    "dependencies": {
        "better-sqlite3": "^11.10.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.2"
    },
    "engines": {
        "node": ">=20"
    }
}
